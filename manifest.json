{
  "manifest_version": 3,
  "name": "Universal Video Speed",
  "version": "1.0.0",
  "description": "Playback speed control for any video or audio on any site, including embedded players.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": { "gecko": { "id": "universal-video-speed@local" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}
