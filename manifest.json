{
  "manifest_version": 3,
  "name": "Presto – Video Speed Control",
  "version": "1.1.0",
  "description": "Playback speed control for any video or audio on any site, including embedded players.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Presto"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "presto@sud747.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "src/steps.js",
        "src/content.js"
      ]
    }
  ]
}
